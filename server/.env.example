# FieldProof server configuration. Copy to .env and fill in. Never commit the real .env.

# development | production. In production JWT_SECRET is required and cookies are HTTPS-only.
NODE_ENV=production
PORT=3000

# Long random string used to sign sessions. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Public address of the app, used in emails and notification links.
APP_URL=https://app.example.com

# Where data lives. Back up both (see DEPLOY.md).
DATABASE_FILE=./data/fieldproof.db
UPLOAD_DIR=./data/uploads

# Built web app served by this server (npm run build in ../web).
WEB_DIST=../web/dist

# Set true when running behind a reverse proxy (Caddy, Nginx, Render, Fly) so rate limits see real client IPs.
TRUST_PROXY=true

# Optional: require this code to register a new company. Leave empty to allow open registration.
SIGNUP_CODE=

# Largest photo upload in MB (photos are compressed on the phone to about 300 KB).
MAX_UPLOAD_MB=8

# Email (invitations, password resets, alerts). Without SMTP_HOST, emails are printed to the server log.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=FieldProof <no-reply@example.com>

# Web push notifications. Generate keys with: npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
